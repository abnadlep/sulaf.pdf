*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Cairo',sans-serif;
}

body{
background:#0f172a;
color:white;
overflow-x:hidden;
}

.navbar{
display:flex;
justify-content:space-between;
padding:20px;
background:rgba(0,0,0,0.5);
backdrop-filter:blur(10px);
}

.navbar a{
color:white;
margin:0 10px;
text-decoration:none;
}

.hero{
position:relative;
height:100vh;
}

#bg3d{
position:absolute;
width:100%;
height:100%;
display:block;
}

.hero-content{
position:relative;
z-index:2;
text-align:center;
top:40%;
}

.cta{
display:inline-block;
margin-top:20px;
padding:15px 40px;
background:#8b5cf6;
border-radius:30px;
color:white;
text-decoration:none;
}

.grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
gap:20px;
padding:40px;
}

.form-section{
padding:40px;
display:flex;
flex-direction:column;
gap:15px;
align-items:center;
}

input{
padding:10px;
border-radius:15px;
border:none;
width:60%;
}

button{
padding:10px 20px;
border:none;
border-radius:20px;
background:#8b5cf6;
color:white;
cursor:pointer;
}

.pricing{
display:flex;
justify-content:center;
gap:40px;
padding:50px;
}

.plan{
background:rgba(255,255,255,0.05);
padding:30px;
border-radius:20px;
text-align:center;
}

.premium{
border:2px solid gold;
}

